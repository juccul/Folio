#!/bin/sh
set -eu
folio_bundle_root=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
# Temporary GNOME compatibility mode after a confirmed tablet-proximity crash.
# This changes only this process's backend, never GNOME/device configuration.
case "${XDG_CURRENT_DESKTOP:-}" in
    *GNOME*)
        if [ "${FOLIO_NATIVE_WAYLAND:-0}" != 1 ]; then
            export WAYLAND_DISPLAY=
        fi
        ;;
esac
exec "$folio_bundle_root/bin/folio-native" "$@"
