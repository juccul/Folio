#!/bin/sh
set -eu
folio_bundle_root=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
# GPUI selects native Wayland when the session provides it, otherwise X11.
# An explicit fallback changes only Folio's backend for this launch.
if [ "${FOLIO_FORCE_X11:-0}" = 1 ]; then
    export WAYLAND_DISPLAY=
fi
exec "$folio_bundle_root/bin/folio-native" "$@"
